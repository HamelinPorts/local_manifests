<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for the Samsung Galaxy Tab A8 (SM-X205, gta8) on
    LineageOS 23.2.

    Self-contained: defines its own remote so it can coexist with
    common.xml (which uses 'los' / 'hamelinports' / 'Development' for
    the A51 family) without remote-name collisions.

    Notes:

    * vendor/samsung/gta8 is NOT pulled here.  The vendor tree is the
      output of `device/samsung/gta8/extract-files.py`; running the
      extract from a rooted SM-X205 (or an unpacked factory image)
      reproduces the directory.  See EXTRACT.md in the device tree.

    * Private development repos (vendor blobs, the 6.12 kernel and the
      6.12 graphics stack) are not listed here.  A local, unpublished
      gta8-private.xml next to this file adds them for development
      checkouts; this file alone syncs every public dependency.

    * The wpa_supplicant_8 entry overrides the LineageOS default to
      pull a fork carrying the SPRD vendor SAE protocol
      (Samsung-OUI UWE5622) needed for WPA3-SAE on this device.

    * The ImsMedia entry replaces the upstream AOSP project with our
      fork, which carries VoLTE media fixes (AMR-WB uplink framing for
      the 40 ms Unisoc UMS512 capture burst, AMR/EVS downlink
      depacketizing, AAudio start timeout) and opens its AAudio streams
      SHARED; HAMELINPORTS.md in the fork lists the commits.  Without
      the fixes VoLTE audio is silent in one or both directions.

    * The Bluetooth entry replaces the LineageOS module with our fork,
      which lets two A2DP sinks stream at once (dual audio, armed by a
      sysprop and driven by the BluetoothDualAudio app); docs/ in the
      fork describes the hooks and the rebase procedure.
-->
<manifest>

    <remote name="gta8-hamelin"
            fetch="https://github.com/HamelinPorts/"
            revision="lineage-23.2" />

    <!-- Device tree -->
    <project path="device/samsung/gta8"
             name="android_device_samsung_gta8"
             remote="gta8-hamelin" />

    <!-- Kernel (4.14-openela; default build) -->
    <project path="kernel/samsung/gta8"
             name="android_kernel_samsung_gta8"
             remote="gta8-hamelin" />

    <!-- Face biometrics AIDL HAL over the Samsung vendor face service
         (BoardConfig.mk include + samsung-face-aidl.mk).  Listed in the
         device lineage.dependencies; pin it here so a plain `repo sync`
         restores it. -->
    <project path="hardware/samsung-face-aidl"
             name="android_hardware_samsung_face_aidl"
             remote="gta8-hamelin"
             revision="a641c2ee8d26719729c2ebab6e0318787c75a5a0"
             upstream="lineage-23.2" />

    <!-- Dual-A2DP companion app (referenced by device.mk PRODUCT_PACKAGES +
         BoardConfig sepolicy). Listed in the device lineage.dependencies but
         not pulled by a plain `repo sync`; pin it here so it always restores. -->
    <project path="packages/apps/BluetoothDualAudio"
             name="android_packages_apps_BluetoothDualAudio"
             remote="gta8-hamelin" />

    <!-- HamelinPortsImsService + native deps for VoLTE bring-up. -->
    <project path="external/resiprocate"
             name="android_external_resiprocate"
             remote="gta8-hamelin" />
    <project path="external/c-ares"
             name="android_external_c-ares"
             remote="gta8-hamelin" />
    <project path="packages/apps/HamelinPortsImsService"
             name="android_external_HamelinPortsImsService"
             remote="gta8-hamelin" />

    <!-- IMS status Quick-Settings tile (device.mk PRODUCT_PACKAGES).
         Listed in the device lineage.dependencies; pin it here so a
         plain `repo sync` restores it. -->
    <project path="packages/apps/HamelinPortsImsStatus"
             name="android_external_HamelinPortsImsStatus"
             remote="gta8-hamelin"
             revision="6077de3530cf7b3c16333952ab4e98a02eab52a4"
             upstream="lineage-23.2" />

    <!-- ImsMedia fork (VoLTE media fixes; see HAMELINPORTS.md in the
         fork). -->
    <remove-project name="platform/packages/modules/ImsMedia" />
    <project path="packages/modules/ImsMedia"
             name="android_packages_modules_ImsMedia"
             remote="gta8-hamelin" />

    <!-- Bluetooth fork (dual A2DP; see docs/DUAL_A2DP.md in the fork).
         Pinned to the commit the images are built from (tagged in the
         fork); dual-a2dp is rebased onto LineageOS per docs/REBASE.md. -->
    <remove-project name="LineageOS/android_packages_modules_Bluetooth" />
    <project path="packages/modules/Bluetooth"
             name="android_packages_modules_Bluetooth"
             remote="gta8-hamelin"
             revision="9df34ffeef6350dce477547198f753efa5ce0132"
             upstream="dual-a2dp"
             groups="pdk" />

    <!-- wpa_supplicant_8 fork: SPRD vendor SAE protocol for the
         UWE5622 firmware.  Rebase against LineageOS via
         `git fetch upstream && git rebase upstream/lineage-23.2`
         from inside external/wpa_supplicant_8. -->
    <remove-project name="LineageOS/android_external_wpa_supplicant_8" />
    <project path="external/wpa_supplicant_8"
             name="android_external_wpa_supplicant_8"
             remote="gta8-hamelin"
             revision="gta8-sprd-sae" />

</manifest>
