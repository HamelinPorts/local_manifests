<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="hamelinports"
     fetch="https://github.com/HamelinPorts/"
     revision="lineage-23.2" />

  <!-- HamelinPortsImsService and its native deps for X205 VoLTE bring-up.
       No revision= on individual projects: tracks the remote's default
       branch head (lineage-23.2). -->
  <project path="external/resiprocate"
           name="android_external_resiprocate"
           remote="hamelinports" />
  <project path="external/c-ares"
           name="android_external_c-ares"
           remote="hamelinports" />
  <project path="packages/apps/HamelinPortsImsService"
           name="android_external_HamelinPortsImsService"
           remote="hamelinports" />

  <!-- Replace the AOSP ImsMedia project with our fork that carries the
       AAudio capture-read-chunk fix. Without it MediaCodec emits two
       concatenated AMR-WB frames per output buffer on Unisoc UMS512
       (40 ms HAL burst vs 20 ms ptime), which the per-frame payload
       parser rejects as NoData. See HAMELINPORTS.md in the fork. -->
  <remove-project name="platform/packages/modules/ImsMedia" />
  <project path="packages/modules/ImsMedia"
           name="android_packages_modules_ImsMedia"
           remote="hamelinports" />
</manifest>
